# === Uygulama ===
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false
API_HOST=127.0.0.1
API_PORT=8000

# === Veritabani ===
DATABASE_URL=sqlite+aiosqlite:///./data/finance.db

# === Gemini ===
GEMINI_API_KEY=
# Kullanilabilir modeller anahtara gore degisir; yeni projelerde gemini-2.5-*
# kapali olabilir. Listelemek icin: genai.list_models()
GEMINI_MODEL=gemini-3.6-flash
LLM_DAILY_CALL_LIMIT=500
# Gemini 3.x "dusunme" tokenlarini da bu butceden harcar; 512 gibi dar bir deger
# JSON ciktiyi yarida keser.
LLM_MAX_OUTPUT_TOKENS=2048

# === Pushover ===
PUSHOVER_TOKEN=
PUSHOVER_USER=

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Bildirim ===
# Sirali deneme: ilk basarili kanalda durur (tekrar bildirim yok)
NOTIFY_CHANNEL_ORDER=telegram,pushover

# === Tarama ayarlari ===
SCAN_CONCURRENCY=5
MIN_CONFIDENCE=0.55
MIN_NOTIFY_SCORE=0.60
SIGNAL_COOLDOWN_MINUTES=240
SENTIMENT_LOOKBACK_HOURS=24
NEWS_POLL_DAYS=1
NEWS_POLL_INTERVAL_MINUTES=15
INTRADAY_INTERVAL=1h
BIST_SYMBOLS=THYAO.IS,ASELS.IS,GARAN.IS
NASDAQ_SYMBOLS=AAPL,MSFT,NVDA

# === Skorlama agirliklari ===
WEIGHT_VISION=0.5
WEIGHT_SENTIMENT=0.3
WEIGHT_INDICATOR=0.2

# === UI (Flet paneli) ===
UI_REFRESH_SECONDS=30

# === Vision ===
YOLO_MODEL_PATH=models/yolov8n.pt
CHART_WIDTH=640
CHART_HEIGHT=640

# === Scraper ===
SEC_USER_AGENT=financial-ai-agent contact@example.com
